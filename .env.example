# Copy to .env for local development only. Never commit your .env.
# Use a unique username and password; a long password is recommended.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
# Generate independently: openssl rand -hex 32
SESSION_SECRET=replace-with-at-least-32-random-characters
# Production: exact public HTTPS origin, without a path or trailing slash.
# Local: omit PUBLIC_URL to use the request's HTTP origin.
# PUBLIC_URL=https://your-service.up.railway.app
# Railway: attach a persistent volume at /data and set DATA_DIR=/data.
DATA_DIR=./data
# Railway supplies PORT automatically; do not hardcode it in Railway.
PORT=3000
NODE_ENV=development
