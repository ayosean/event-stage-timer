// Cloudflare backup deployment. Independent of the Railway service: it has
// its own URL, its own login secrets, and its own timer state.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "event-stage-timer-backup",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "../dist/client",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true,
  },
  "durable_objects": {
    "bindings": [{ "name": "TIMER", "class_name": "TimerRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TimerRoom"] }],
  "observability": { "enabled": true },
}
